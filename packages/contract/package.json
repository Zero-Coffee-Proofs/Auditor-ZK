{
  "name": "contracts",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./generated": "./dist/generated",
    "./generated/*": "./dist/generated/*",
    "./generated/contract": {
      "types": "./dist/generated/contract/index.d.cts",
      "require": "./dist/generated/contract/index.cjs"
    },
    "./generated/compiler/*": "./dist/managed/compiler/*",
    "./generated/keys/*": "./dist/generated/keys/*",
    "./generated/zkir/*": "./dist/generated/zkir/*"
  },
  "scripts": {
    "build": "rm -rf dist && pnpm run compact && tsc --project tsconfig.build.json && cp -r ./src/generated ./dist/generated && cp ./src/kyc.compact ./dist",
    "compact": "compact compile src/kyc.compact ./src/generated",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.29.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.1",
    "globals": "^16.2.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.9.0"
  }
}
