pragma language_version >= 0.18;

import CompactStandardLibrary;



/**
 * Example of rule to create
 *
 * “This borrower has passed Blockpass KYC and has verified monthly income > $2,000 and 
 * debt-to-income ratio < 40% — without revealing any sensitive info.”
 */
export struct Assertion {
  /** the version of the rules this assertion is based on */
  version: Uint<64>;
  /** monthly income >= than rule.monthlyIncome */
  income: Uint<1>;
  /** debt-to-income ratio <= rule.maxDebtToIncomeRatio */
  debtToIncomeRatio: Uint<1>;
  /** outstanding debt <= rule.maxDebt */
  outstandingDebt: Uint<1>;
  /** total balance >= rule.minBalance */
  minBalance: Uint<1>;
  /** age >= rule.minAge */
  age: Uint<1>;
  /** compliant kyc */
  kyc: Uint<1>;
}

// could use Ownable by Open Zeppelin here but KISS
//export ledger _owner: Either<ZswapCoinPublicKey, ContractAddress>

// TODO: add a HashMap for RuleSet by hash to allow creators of multiple rule sets

/** Loan rules */
export struct RuleSet {
  // when rules are updated, increment version
  // TODO: figure out why I couldn't use Counter here
  version: Uint<64>;
  monthlyIncome: Uint<64>;
  // Number between 0 and 100 representing percentage without decimal points
  debtToIncomeRatio: Uint<64>;
  outstandingDebt: Uint<64>;
  minBalance: Uint<64>;
  minAge: Uint<64>;
}

export ledger rules: RuleSet;

constructor(newRules: RuleSet) {
  // for now anyone can set new rules
  // TODO: add checks here
  rules = disclose(newRules);
}

circuit updateRules(newRules: RuleSet): [] {
  // for now anyone can set new rules
  // TODO: add checks here
  const oldRules = rules;
  rules = disclose(newRules);
}

witness secret_key(): Bytes<32>;
witness salt(): Bytes<32>;

