pragma language_version >= 0.18;

import CompactStandardLibrary;
import "./oz/access/Ownable" prefix Ownable_;

/*
    ================================
    PROOF OF RESERVES TOKEN CONTRACT
    ================================

    This contract implements a tokenized asset backed by cryptographic proof of reserves
    using TLSNotary attestations. The contract ensures that tokens can only be minted once,
    and only after proving knowledge of reserves that meet a minimum threshold.

    ARCHITECTURE:
    1. Owner (AuditorZK) submits proof of reserves commitment from TLSNotary verifier
    2. User proves knowledge of balance matching the commitment in zero-knowledge
    3. User mints tokens (one-time operation) if balance >= threshold >= amountToMint

    PRIVACY GUARANTEES:
    - User's exact balance is NEVER revealed on-chain
    - Only the commitment hash and threshold are public
    - ZK circuit proves balance > threshold without disclosing the actual amount
*/

///////////////////
// PRIVATE STATE //
///////////////////

// Witnesses used for identity management and nullifier creation
witness secret_key(): Bytes<32>;
witness salt(): Bytes<32>;

//////////////////
// PUBLIC STATE //
//////////////////

// Proof of reserves submitted by the contract owner (AuditorZK)
export struct ProofOfReserves {
  commitment: Bytes<32>;      // hash(balance || blinder) from TLSNotary attestation
  timestamp: Uint<64>;         // Unix timestamp when proof was submitted
  threshold: Uint<64>;         // Minimum balance required for minting (in cents)
}

// Token metadata and supply tracking
export struct TokenInfo {
  name: Bytes<64>;             // Token name (e.g., "ProvedUSDC")
  totalSupply: Uint<64>;       // Total number of tokens minted
}

// Ledger state
// Note: Ownable module provides: export ledger _owner: Either<ZswapCoinPublicKey, ContractAddress>
export ledger tokenInfo: TokenInfo;
export ledger proofOfReserves: ProofOfReserves;
export ledger minted: Uint<1>;                     // 0 = not minted, 1 = tokens have been minted
export ledger balances: Map<Bytes<32>, Uint<64>>; // Nullifier -> token balance (privacy-preserving)
export ledger pricePerToken: Uint<64>;              // Price per token in smallest unit (e.g., cents)
export ledger issuerNullifier: Bytes<32>;          // Issuer's nullifier set during mint
ledger accumulatedPayments: Map<Bytes<32>, QualifiedCoinInfo>; // Payments for issuer to claim

/*
    CONSTRUCTOR

    Initializes the contract with:
    - Owner (deployer) who can submit proofs
    - Token name
    - Price per token
    - Empty proof of reserves (threshold = 0 initially)
    - Payment type is always tDUST (native token)

    @param _tokenName - The name of the token (padded to 64 bytes)
    @param _pricePerToken - Price per token in smallest unit (e.g., 100 = 1 tDUST)
*/
constructor(
  _tokenName: Bytes<64>,
  _pricePerToken: Uint<64>
) {
  // Initialize Ownable module with the deployer as owner
  const own = left<ZswapCoinPublicKey, ContractAddress>(disclose(ownPublicKey()));
  Ownable_initialize(own);

  // Initialize token metadata
  tokenInfo = disclose(TokenInfo {
    name: _tokenName,
    totalSupply: 0
  });

  // Initialize empty proof of reserves (threshold starts at 0)
  proofOfReserves = disclose(ProofOfReserves {
    commitment: pad(32, ""),
    timestamp: 0,
    threshold: 0
  });

  // Set payment configuration - always use native token (tDUST)
  pricePerToken = disclose(_pricePerToken);

  // Token not yet minted, issuer not set
  minted = disclose(0);
  issuerNullifier = disclose(pad(32, ""));
}

/*
    SUBMIT PROOF OF RESERVES

    Called by the contract owner (AuditorZK) to update the proof of reserves.
    This submits the commitment hash created by the TLSNotary verifier server.

    OWNER ONLY - Uses OpenZeppelin Ownable access control

    @param commitment - hash(balance || blinder) from TLSNotary attestation
    @param timestamp - Unix timestamp when the proof was created
    @param threshold - Minimum balance required for minting (in cents, e.g., 1000000 = $10,000)
*/
export circuit submitProof(
  commitment: Bytes<32>,
  timestamp: Uint<64>,
  threshold: Uint<64>
): [] {
  // Only the contract owner can submit proofs
  Ownable_assertOnlyOwner();

  // Update the global proof of reserves
  proofOfReserves = disclose(ProofOfReserves {
    commitment: commitment,
    timestamp: timestamp,
    threshold: threshold
  });
}

/*
    MINT TOKENS

    Allows the issuer to mint tokens by proving they know the balance and blinder
    that match the committed proof of reserves.

    ONE-TIME OPERATION - Once tokens are minted, this circuit cannot be called again.
    NO PAYMENT REQUIRED - Issuer proves reserves to mint, then sells tokens separately.

    PRIVACY: The issuer's actual balance is kept private. The circuit proves in zero-knowledge:
    1. Issuer knows balance and blinder such that hash(balance || blinder) == commitment
    2. balance >= threshold (meets minimum reserve requirement)
    3. threshold >= amountToMint (minting amount is within limits)

    The issuer's nullifier is stored publicly for token sales.

    @param balance - PRIVATE: Issuer's actual balance in cents (e.g., 2091275 = $20,912.75)
    @param blinder - PRIVATE: Blinding factor from MPC protocol (32 bytes)
    @param amountToMint - PUBLIC: Number of tokens to mint
*/
export circuit mint(
  balance: Uint<64>,          // PRIVATE witness
  blinder: Bytes<32>,         // PRIVATE witness
  amountToMint: Uint<64>      // PUBLIC input
): [] {
  // Ensure tokens have not been minted yet
  assert(minted == 0, "Tokens already minted - only one-time minting allowed");

  // Verify knowledge of commitment preimage
  // Reconstruct: commitment = hash(balanceBytes || blinder)
  // Note: persistentHash outputs 32 bytes (SHA256 hash)
  const balanceValue = (balance as Field) as Bytes<32>;
  const computedCommitment = persistentHash<Vector<2, Bytes<32>>>([balanceValue, blinder]);

  assert(computedCommitment == proofOfReserves.commitment,
         "Invalid commitment: provided balance and blinder do not match");

  // Verify balance constraints:
  // 1. Issuer's balance >= threshold (meets minimum reserves)
  // 2. threshold >= amountToMint (minting within allowed limits)
  assert(balance >= proofOfReserves.threshold,
         "Balance below required threshold - insufficient reserves");
  assert(proofOfReserves.threshold >= amountToMint,
         "Mint amount exceeds threshold - cannot mint more than threshold allows");

  // Mint tokens to issuer's nullifier (privacy-preserving)
  // Issuer proves knowledge of secret_key and salt to create nullifier
  const issuerNullifierValue = nullify(secret_key(), salt());
  balances.insert(disclose(issuerNullifierValue), disclose(amountToMint));

  // Store issuer's nullifier publicly for token sales
  issuerNullifier = disclose(issuerNullifierValue);

  // Update total supply
  tokenInfo = disclose(TokenInfo {
    name: tokenInfo.name,
    totalSupply: amountToMint
  });

  // Mark as minted (prevents future minting)
  minted = disclose(1);
}

///////////////////////////
// TOKEN OPERATIONS (TODO)
///////////////////////////

/*
    TRANSFER TOKENS

    Transfer tokens from sender's nullifier to recipient's nullifier.
    Sender proves ownership by providing secret_key and salt that generate their nullifier.

    PRIVACY: Sender proves knowledge of their nullifier without revealing identity.
    Recipient receives tokens at their nullifier address.

    @param toNullifier - Recipient's nullifier (destination)
    @param amount - Amount of tokens to transfer
*/
export circuit transfer(toNullifier: Bytes<32>, amount: Uint<64>): [] {
  // Prove ownership of source nullifier
  // User must provide secret_key and salt as witnesses
  const fromNullifier = disclose(nullify(secret_key(), salt()));

  // Disclose transfer parameters (transfers are public operations)
  const toNullifierD = disclose(toNullifier);
  const amountD = disclose(amount);

  // Check sender has sufficient balance
  const senderBalance = balances.member(fromNullifier) ? balances.lookup(fromNullifier) : (0 as Uint<64>);
  assert(senderBalance >= amountD, "Insufficient balance for transfer");

  // Deduct from sender's nullifier
  const newSenderBalance = (senderBalance - amountD) as Uint<64>;
  balances.remove(fromNullifier);
  if (newSenderBalance > 0) {
    balances.insert(fromNullifier, newSenderBalance);
  }
  // If balance is zero, we just removed it (storage cleanup)

  // Add to recipient's nullifier
  const recipientBalance = balances.member(toNullifierD) ? balances.lookup(toNullifierD) : (0 as Uint<64>);
  const newRecipientBalance = (recipientBalance + amountD) as Uint<64>;

  if (balances.member(toNullifierD)) {
    balances.remove(toNullifierD);
  }
  balances.insert(toNullifierD, newRecipientBalance);
}

/*
    BUY TOKENS

    Allows buyers to purchase tokens from the issuer by sending payment.
    Tokens are transferred from issuer's nullifier to buyer's nullifier.
    Payment is stored in contract for issuer to claim later.

    MULTIPLE PURCHASES ALLOWED - Unlike minting, buying can happen multiple times
    until issuer runs out of tokens.

    @param amountToBuy - PUBLIC: Number of tokens to buy
    @param payment - PUBLIC: Coin to pay for the tokens
*/
export circuit buy(
  amountToBuy: Uint<64>,      // PUBLIC input
  payment: CoinInfo           // PUBLIC input - payment coin
): [] {
  // Tokens must have been minted
  assert(minted == 1, "Tokens not yet minted - cannot buy");

  // Disclose parameters
  const amountToBuyD = disclose(amountToBuy);
  const disclosedPayment = disclose(payment);

  // Verify payment
  const totalPrice = amountToBuyD * pricePerToken;
  assert(disclosedPayment.value >= totalPrice, "Payment amount does not match price");
  // receive(disclosedPayment);

  // Check issuer has sufficient tokens
  const issuerBalance = balances.lookup(issuerNullifier);
  assert(issuerBalance >= amountToBuyD, "Issuer has insufficient tokens for sale");

  // Deduct from issuer's nullifier
  const newIssuerBalance = (issuerBalance - amountToBuyD) as Uint<64>;
  balances.remove(issuerNullifier);
  if (newIssuerBalance > 0) {
    balances.insert(issuerNullifier, newIssuerBalance);
  }

  // Add to buyer's nullifier (buyer proves knowledge of secret_key/salt)
  const buyerNullifier = disclose(nullify(secret_key(), salt()));
  const buyerBalance = balances.member(buyerNullifier) ? balances.lookup(buyerNullifier) : (0 as Uint<64>);
  const newBuyerBalance = (buyerBalance + amountToBuyD) as Uint<64>;

  if (balances.member(buyerNullifier)) {
    balances.remove(buyerNullifier);
  }
  balances.insert(buyerNullifier, newBuyerBalance);

  // Store payment in contract for issuer to claim
  // Use payment color as key (accumulate payments of same type)
  // const existingPayment = accumulatedPayments.member(disclosedPayment.color);
  // if (existingPayment) {
  //   // Merge with existing payment
  //   const existing = accumulatedPayments.lookup(disclosedPayment.color);
  //   const merged = mergeCoinImmediate(existing, disclosedPayment);
  //   accumulatedPayments.remove(disclosedPayment.color);
  //   accumulatedPayments.insertCoin(disclosedPayment.color, merged, right<ZswapCoinPublicKey, ContractAddress>(kernel.self()));
  // } else {
  //   // First payment of this type
  //   accumulatedPayments.insertCoin(disclosedPayment.color, disclosedPayment, right<ZswapCoinPublicKey, ContractAddress>(kernel.self()));
  // }
}

