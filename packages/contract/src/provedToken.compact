////////////////////
// HELPER FUNCTIONS
////////////////////

/*
    PUBLIC KEY DERIVATION

    Derives a public key from a secret key using a persistent hash.

    @param sk - Secret key (32 bytes)
    @returns Public key (32 bytes)
*/
export circuit publicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "pk"), sk]);
}

/*
    NULLIFIER GENERATION

    Creates a deterministic nullifier from a secret key and salt.
    Used for privacy-preserving identity management.

    @param sk - Secret key (32 bytes)
    @param salt - Salt value (32 bytes)
    @returns Nullifier (32 bytes)
*/
export circuit nullify(sk: Bytes<32>, salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "pk"), sk, salt]);
}

export circuit owner(): Either<ZswapCoinPublicKey, ContractAddress> {
  return Ownable_owner();
}

/*
    DEBUG: TEST COMMITMENT HASH

    This circuit helps debug the commitment hash calculation by exposing
    the intermediate steps. It shows exactly how balance is converted to bytes
    and how the hash is computed.

    @param balance - Balance in cents (e.g., 2091275)
    @param blinder - Blinder bytes (32 bytes)
    @returns The computed commitment hash
*/
export circuit debugCommitment(
  balance: Uint<64>,
  blinder: Bytes<32>
): Bytes<32> {
  // This is exactly how mint() computes the commitment
  const balanceValue = (balance as Field) as Bytes<32>;
  const computedCommitment = persistentHash<Vector<2, Bytes<32>>>([balanceValue, blinder]);

  // Return the commitment so we can see what it computes to
  return disclose(computedCommitment);
}
